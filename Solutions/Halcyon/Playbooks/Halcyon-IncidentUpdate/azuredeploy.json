{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "metadata": {
        "title": "Halcyon-IncidentUpdate",
        "description": "Scheduled playbook that keeps open Halcyon Sentinel incidents in sync with the latest Halcyon alert states. Updates incident labels with current triage/display status.",
        "prerequisites": [
            "1. The Halcyon data connector must be deployed and ingesting data into Halcyon_Commands_CL.",
            "2. The HalcyonTriggersRule analytics rule and companion automation rule must be deployed.",
            "3. The deploying principal must have permission to create role assignments on the Log Analytics workspace."
        ],
        "tags": ["Sync", "Halcyon"],
        "author": { "name": "Halcyon" },
        "support": { "tier": "developer", "link": "https://www.halcyon.ai" }
    },
    "parameters": {
        "PlaybookName": {
            "type": "string",
            "defaultValue": "Halcyon-IncidentUpdate"
        },
        "WorkspaceName": {
            "type": "string",
            "metadata": { "description": "Name of the Log Analytics workspace containing Halcyon_Commands_CL and Microsoft Sentinel." }
        },
        "WorkspaceId": {
            "type": "string",
            "metadata": { "description": "GUID of the Log Analytics workspace (found in workspace Properties)." }
        },
        "SubscriptionId": {
            "type": "string",
            "defaultValue": "[subscription().subscriptionId]"
        },
        "ResourceGroupName": {
            "type": "string",
            "defaultValue": "[resourceGroup().name]"
        },
        "RecurrenceInterval": {
            "type": "int",
            "defaultValue": 5,
            "metadata": { "description": "How often to run the sync, in units of RecurrenceFrequency." }
        },
        "RecurrenceFrequency": {
            "type": "string",
            "defaultValue": "Minute",
            "allowedValues": ["Minute", "Hour"]
        }
    },
    "variables": {
        "sentinelResponderRoleId": "3e150937-b8fe-4cfb-8069-0eaf05ecd056",
        "logAnalyticsReaderRoleId": "73c42c96-874c-492b-b04d-ab87d138a893"
    },
    "resources": [
        {
            "type": "Microsoft.Logic/workflows",
            "apiVersion": "2017-07-01",
            "name": "[parameters('PlaybookName')]",
            "location": "[resourceGroup().location]",
            "identity": {
                "type": "SystemAssigned"
            },
            "properties": {
                "state": "Enabled",
                "definition": {
                    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
                    "contentVersion": "1.0.0.0",
                    "parameters": {
                        "workspaceId": {
                            "type": "string",
                            "defaultValue": "[parameters('WorkspaceId')]"
                        },
                        "subscriptionId": {
                            "type": "string",
                            "defaultValue": "[parameters('SubscriptionId')]"
                        },
                        "resourceGroupName": {
                            "type": "string",
                            "defaultValue": "[parameters('ResourceGroupName')]"
                        },
                        "workspaceName": {
                            "type": "string",
                            "defaultValue": "[parameters('WorkspaceName')]"
                        }
                    },
                    "triggers": {
                        "Recurrence": {
                            "type": "Recurrence",
                            "recurrence": {
                                "frequency": "[parameters('RecurrenceFrequency')]",
                                "interval": "[parameters('RecurrenceInterval')]"
                            }
                        }
                    },
                    "actions": {
                        "Main_Scope": {
                            "type": "Scope",
                            "runAfter": {},
                            "actions": {
                                "Run_KQL_Query": {
                                    "type": "Http",
                                    "runAfter": {},
                                    "inputs": {
                                        "method": "POST",
                                        "uri": "https://api.loganalytics.io/v1/workspaces/@{parameters('workspaceId')}/query",
                                        "headers": {
                                            "Content-Type": "application/json"
                                        },
                                        "body": {
                                            "query": "let SettledAlerts = materialize(\n    Halcyon_Commands_CL\n    | where TimeGenerated > ago(14d)\n    | summarize FirstSeen = min(TimeGenerated) by HalcyonAlertId\n    | where FirstSeen < ago(15m)\n);\nlet LatestStatus = materialize(\n    Halcyon_Commands_CL\n    | where TimeGenerated > ago(15m)\n    | where HalcyonAlertId in (SettledAlerts | project HalcyonAlertId)\n    | summarize arg_max(TimeGenerated, *) by HalcyonAlertId\n    | project HalcyonAlertId, HalcyonTriageStatus, HalcyonDisplayStatus\n);\nSecurityIncident\n| where Labels has_cs \"Halcyon\"\n| summarize arg_max(TimeGenerated, *) by IncidentNumber\n| where Status != \"Closed\"\n| mv-expand AlertIds to typeof(string)\n| join kind=inner (\n    SecurityAlert\n    | where AlertName has \"Halcyon\"\n    | extend HalcyonAlertId = tostring(ExtendedProperties[\"HalcyonAlertId\"])\n    | where HalcyonAlertId in (LatestStatus | project HalcyonAlertId)\n    | project SystemAlertId, HalcyonAlertId\n) on $left.AlertIds == $right.SystemAlertId\n| join kind=inner LatestStatus on HalcyonAlertId\n| project IncidentId = IncidentName, HalcyonAlertId, HalcyonTriageStatus, HalcyonDisplayStatus"
                                        },
                                        "authentication": {
                                            "type": "ManagedServiceIdentity",
                                            "audience": "https://api.loganalytics.io"
                                        }
                                    },
                                    "retryPolicy": {
                                        "type": "fixed",
                                        "count": 3,
                                        "interval": "PT10S"
                                    }
                                },
                                "Parse_Query_Results": {
                                    "type": "ParseJson",
                                    "runAfter": {
                                        "Run_KQL_Query": ["Succeeded"]
                                    },
                                    "inputs": {
                                        "content": "@body('Run_KQL_Query')",
                                        "schema": {
                                            "type": "object",
                                            "properties": {
                                                "tables": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "object",
                                                        "properties": {
                                                            "columns": { "type": "array" },
                                                            "rows": { "type": "array" }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                },
                                "Map_Rows": {
                                    "type": "Select",
                                    "runAfter": {
                                        "Parse_Query_Results": ["Succeeded"]
                                    },
                                    "inputs": {
                                        "from": "@body('Parse_Query_Results')?['tables'][0]?['rows']",
                                        "select": {
                                            "IncidentId": "@item()[0]",
                                            "HalcyonAlertId": "@item()[1]",
                                            "HalcyonTriageStatus": "@item()[2]",
                                            "HalcyonDisplayStatus": "@item()[3]"
                                        }
                                    }
                                },
                                "For_Each_Alert": {
                                    "type": "Foreach",
                                    "runAfter": {
                                        "Map_Rows": ["Succeeded"]
                                    },
                                    "foreach": "@body('Map_Rows')",
                                    "runtimeConfiguration": {
                                        "concurrency": { "repetitions": 1 }
                                    },
                                    "actions": {
                                        "Get_Incident": {
                                            "type": "Http",
                                            "runAfter": {},
                                            "inputs": {
                                                "method": "GET",
                                                "uri": "https://management.azure.com/subscriptions/@{parameters('subscriptionId')}/resourceGroups/@{parameters('resourceGroupName')}/providers/Microsoft.OperationalInsights/workspaces/@{parameters('workspaceName')}/providers/Microsoft.SecurityInsights/incidents/@{items('For_Each_Alert')?['IncidentId']}?api-version=2023-11-01",
                                                "authentication": {
                                                    "type": "ManagedServiceIdentity",
                                                    "audience": "https://management.azure.com"
                                                }
                                            },
                                            "retryPolicy": {
                                                "type": "fixed",
                                                "count": 3,
                                                "interval": "PT10S"
                                            }
                                        },
                                        "Filter_Existing_Labels": {
                                            "type": "Query",
                                            "runAfter": {
                                                "Get_Incident": ["Succeeded"]
                                            },
                                            "inputs": {
                                                "from": "@coalesce(body('Get_Incident')?['properties']?['labels'], createArray())",
                                                "where": "@and(not(startsWith(coalesce(item()?['labelName'], ''), 'Halcyon Triage Status:')), not(startsWith(coalesce(item()?['labelName'], ''), 'Halcyon Display Status:')))"
                                            }
                                        },
                                        "Compose_Triage_Label": {
                                            "type": "Compose",
                                            "runAfter": {
                                                "Filter_Existing_Labels": ["Succeeded"]
                                            },
                                            "inputs": "@if(empty(coalesce(items('For_Each_Alert')?['HalcyonTriageStatus'], '')), createArray(), createArray(createObject('labelName', concat('Halcyon Triage Status: ', items('For_Each_Alert')?['HalcyonTriageStatus']))))"
                                        },
                                        "Compose_Display_Label": {
                                            "type": "Compose",
                                            "runAfter": {
                                                "Compose_Triage_Label": ["Succeeded"]
                                            },
                                            "inputs": "@if(empty(coalesce(items('For_Each_Alert')?['HalcyonDisplayStatus'], '')), createArray(), createArray(createObject('labelName', concat('Halcyon Display Status: ', items('For_Each_Alert')?['HalcyonDisplayStatus']))))"
                                        },
                                        "Compose_Final_Labels": {
                                            "type": "Compose",
                                            "runAfter": {
                                                "Compose_Display_Label": ["Succeeded"]
                                            },
                                            "inputs": "@union(body('Filter_Existing_Labels'), outputs('Compose_Triage_Label'), outputs('Compose_Display_Label'))"
                                        },
                                        "Update_Incident": {
                                            "type": "Http",
                                            "runAfter": {
                                                "Compose_Final_Labels": ["Succeeded"]
                                            },
                                            "inputs": {
                                                "method": "PUT",
                                                "uri": "https://management.azure.com/subscriptions/@{parameters('subscriptionId')}/resourceGroups/@{parameters('resourceGroupName')}/providers/Microsoft.OperationalInsights/workspaces/@{parameters('workspaceName')}/providers/Microsoft.SecurityInsights/incidents/@{items('For_Each_Alert')?['IncidentId']}?api-version=2023-11-01",
                                                "headers": {
                                                    "Content-Type": "application/json",
                                                    "If-Match": "@body('Get_Incident')?['etag']"
                                                },
                                                "body": {
                                                    "etag": "@body('Get_Incident')?['etag']",
                                                    "properties": {
                                                        "title": "@body('Get_Incident')?['properties']?['title']",
                                                        "status": "@body('Get_Incident')?['properties']?['status']",
                                                        "severity": "@body('Get_Incident')?['properties']?['severity']",
                                                        "description": "@body('Get_Incident')?['properties']?['description']",
                                                        "owner": "@body('Get_Incident')?['properties']?['owner']",
                                                        "classification": "@body('Get_Incident')?['properties']?['classification']",
                                                        "classificationComment": "@body('Get_Incident')?['properties']?['classificationComment']",
                                                        "classificationReason": "@body('Get_Incident')?['properties']?['classificationReason']",
                                                        "labels": "@outputs('Compose_Final_Labels')"
                                                    }
                                                },
                                                "authentication": {
                                                    "type": "ManagedServiceIdentity",
                                                    "audience": "https://management.azure.com"
                                                }
                                            },
                                            "retryPolicy": {
                                                "type": "fixed",
                                                "count": 3,
                                                "interval": "PT10S"
                                            }
                                        }
                                    }
                                }
                            }
                        },
                        "Handle_Failure": {
                            "type": "Compose",
                            "runAfter": {
                                "Main_Scope": ["Failed", "Skipped", "TimedOut"]
                            },
                            "inputs": {
                                "message": "Halcyon-IncidentUpdate playbook failed.",
                                "scopeStatus": "@result('Main_Scope')",
                                "runId": "@workflow().run.name",
                                "workflowName": "@workflow().name"
                            }
                        },
                        "Terminate_With_Failure": {
                            "type": "Terminate",
                            "runAfter": {
                                "Handle_Failure": ["Succeeded"]
                            },
                            "inputs": {
                                "runStatus": "Failed",
                                "runError": {
                                    "code": "MainScopeFailed",
                                    "message": "@{string(outputs('Handle_Failure'))}"
                                }
                            }
                        }
                    }
                }
            }
        },
        {
            "type": "Microsoft.Authorization/roleAssignments",
            "apiVersion": "2022-04-01",
            "name": "[guid(resourceId('Microsoft.OperationalInsights/workspaces', parameters('WorkspaceName')), resourceId('Microsoft.Logic/workflows', parameters('PlaybookName')), variables('sentinelResponderRoleId'))]",
            "scope": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('WorkspaceName'))]",
            "dependsOn": [
                "[resourceId('Microsoft.Logic/workflows', parameters('PlaybookName'))]"
            ],
            "properties": {
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('sentinelResponderRoleId'))]",
                "principalId": "[reference(resourceId('Microsoft.Logic/workflows', parameters('PlaybookName')), '2017-07-01', 'Full').identity.principalId]",
                "principalType": "ServicePrincipal"
            }
        },
        {
            "type": "Microsoft.Authorization/roleAssignments",
            "apiVersion": "2022-04-01",
            "name": "[guid(resourceId('Microsoft.OperationalInsights/workspaces', parameters('WorkspaceName')), resourceId('Microsoft.Logic/workflows', parameters('PlaybookName')), variables('logAnalyticsReaderRoleId'))]",
            "scope": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('WorkspaceName'))]",
            "dependsOn": [
                "[resourceId('Microsoft.Logic/workflows', parameters('PlaybookName'))]"
            ],
            "properties": {
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('logAnalyticsReaderRoleId'))]",
                "principalId": "[reference(resourceId('Microsoft.Logic/workflows', parameters('PlaybookName')), '2017-07-01', 'Full').identity.principalId]",
                "principalType": "ServicePrincipal"
            }
        }
    ]
}