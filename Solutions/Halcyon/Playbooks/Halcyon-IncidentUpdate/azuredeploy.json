{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "metadata": {
        "title": "Halcyon-IncidentUpdate",
        "description": "Scheduled playbook that keeps open Halcyon Sentinel incidents in sync with the latest Halcyon alert states. Updates incident labels with current triage/display status.",
        "prerequisites": [
            "1. The Halcyon data connector must be deployed and ingesting data into Halcyon_Commands_CL.",
            "2. The HalcyonTriggersRule analytics rule and companion automation rule must be deployed.",
            "3. The deploying principal must have permission to create role assignments on the Log Analytics workspace."
        ],
        "tags": ["Sync", "Halcyon"],
        "author": { "name": "Halcyon" },
        "support": { "tier": "developer", "link": "https://www.halcyon.ai" }
    },
    "parameters": {
        "PlaybookName": {
            "type": "string",
            "defaultValue": "Halcyon-IncidentUpdate"
        },
        "WorkspaceName": {
            "type": "string",
            "metadata": { "description": "Name of the Log Analytics workspace containing Halcyon_Commands_CL and Microsoft Sentinel." }
        },
        "SubscriptionId": {
            "type": "string",
            "defaultValue": "[subscription().subscriptionId]"
        },
        "ResourceGroupName": {
            "type": "string",
            "defaultValue": "[resourceGroup().name]"
        },
        "RecurrenceInterval": {
            "type": "int",
            "defaultValue": 5,
            "metadata": { "description": "How often to run the sync, in units of RecurrenceFrequency." }
        },
        "RecurrenceFrequency": {
            "type": "string",
            "defaultValue": "Minute",
            "allowedValues": ["Minute", "Hour"]
        }
    },
    "variables": {
        "sentinelResponderRoleId": "3e150937-b8fe-4cfb-8069-0eaf05ecd056",
        "logAnalyticsReaderRoleId": "73c42c96-874c-492b-b04d-ab87d138a893",
        "monitoringReaderRoleId": "43d0d8ad-25c7-4714-9337-8ba259a9fe05",
        "azureMonitorLogsConnectionName": "[concat('azuremonitorlogs-', parameters('PlaybookName'))]",
        "azureSentinelConnectionName": "[concat('azuresentinel-', parameters('PlaybookName'))]"
    },
    "resources": [
        {
            "type": "Microsoft.Web/connections",
            "apiVersion": "2016-06-01",
            "name": "[variables('azureMonitorLogsConnectionName')]",
            "location": "[resourceGroup().location]",
            "kind": "V1",
            "properties": {
                "displayName": "[variables('azureMonitorLogsConnectionName')]",
                "customParameterValues": {},
                "parameterValueSet": {
                    "name": "managedIdentityAuth",
                    "values": {}
                },
                "api": {
                    "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/azuremonitorlogs')]"
                }
            }
        },
        {
            "type": "Microsoft.Web/connections",
            "apiVersion": "2016-06-01",
            "name": "[variables('azureSentinelConnectionName')]",
            "location": "[resourceGroup().location]",
            "kind": "V1",
            "properties": {
                "displayName": "[variables('azureSentinelConnectionName')]",
                "customParameterValues": {},
                "parameterValueType": "Alternative",
                "api": {
                    "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/azuresentinel')]"
                }
            }
        },
        {
            "type": "Microsoft.Logic/workflows",
            "apiVersion": "2019-05-01",
            "name": "[parameters('PlaybookName')]",
            "location": "[resourceGroup().location]",
            "identity": {
                "type": "SystemAssigned"
            },
            "dependsOn": [
                "[resourceId('Microsoft.Web/connections', variables('azureMonitorLogsConnectionName'))]",
                "[resourceId('Microsoft.Web/connections', variables('azureSentinelConnectionName'))]"
            ],
            "properties": {
                "state": "Enabled",
                "runtimeConfiguration": {
                    "concurrency": {
                        "runs": 1
                    }
                },
                "parameters": {
                    "$connections": {
                        "value": {
                            "azuremonitorlogs": {
                                "connectionId": "[resourceId('Microsoft.Web/connections', variables('azureMonitorLogsConnectionName'))]",
                                "connectionName": "[variables('azureMonitorLogsConnectionName')]",
                                "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/azuremonitorlogs')]",
                                "connectionProperties": {
                                    "authentication": {
                                        "type": "ManagedServiceIdentity"
                                    }
                                }
                            },
                            "azuresentinel": {
                                "connectionId": "[resourceId('Microsoft.Web/connections', variables('azureSentinelConnectionName'))]",
                                "connectionName": "[variables('azureSentinelConnectionName')]",
                                "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/azuresentinel')]",
                                "connectionProperties": {
                                    "authentication": {
                                        "type": "ManagedServiceIdentity"
                                    }
                                }
                            }
                        }
                    }
                },
                "definition": {
                    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
                    "contentVersion": "1.0.0.0",
                    "parameters": {
                        "$connections": {
                            "defaultValue": {},
                            "type": "Object"
                        },
                        "subscriptionId": {
                            "type": "string",
                            "defaultValue": "[parameters('SubscriptionId')]"
                        },
                        "resourceGroupName": {
                            "type": "string",
                            "defaultValue": "[parameters('ResourceGroupName')]"
                        },
                        "workspaceName": {
                            "type": "string",
                            "defaultValue": "[parameters('WorkspaceName')]"
                        }
                    },
                    "triggers": {
                        "Recurrence": {
                            "type": "Recurrence",
                            "recurrence": {
                                "frequency": "[parameters('RecurrenceFrequency')]",
                                "interval": "[parameters('RecurrenceInterval')]"
                            }
                        }
                    },
                    "actions": {
                        "Main_Scope": {
                            "type": "Scope",
                            "runAfter": {},
                            "actions": {
                                "Run_KQL_Query": {
                                    "type": "ApiConnection",
                                    "runAfter": {},
                                    "inputs": {
                                        "host": {
                                            "connection": {
                                                "name": "@parameters('$connections')['azuremonitorlogs']['connectionId']"
                                            }
                                        },
                                        "method": "post",
                                        "path": "/queryData",
                                        "queries": {
                                            "subscriptions": "@parameters('subscriptionId')",
                                            "resourcegroups": "@parameters('resourceGroupName')",
                                            "resourcetype": "Log Analytics Workspace",
                                            "resourcename": "@parameters('workspaceName')",
                                            "timerange": "Set in query"
                                        },
                                        "body": {
                                            "query": "let SettledAlerts = materialize(\n    Halcyon_Commands_CL\n    | summarize FirstSeen = min(TimeGenerated) by HalcyonAlertId\n    | where FirstSeen < ago(15m)\n);\nlet LatestStatus = materialize(\n    Halcyon_Commands_CL\n    | where TimeGenerated > ago(15m)\n    | where HalcyonAlertId in (SettledAlerts | project HalcyonAlertId)\n    | summarize arg_max(TimeGenerated, *) by HalcyonAlertId\n    | project HalcyonAlertId, HalcyonTriageStatus, HalcyonDisplayStatus\n);\nSecurityIncident\n| where Labels has_cs \"Halcyon\"\n| summarize arg_max(TimeGenerated, *) by IncidentNumber\n| where Status != \"Closed\"\n| mv-expand AlertIds to typeof(string)\n| join kind=inner (\n    SecurityAlert\n    | where AlertName has \"Halcyon\"\n    | extend CustomDetails = parse_json(tostring(parse_json(tostring(ExtendedProperties))[\"Custom Details\"]))\n    | extend HalcyonAlertId = tostring(CustomDetails[\"HalcyonAlertId\"][0])\n    | where HalcyonAlertId in (LatestStatus | project HalcyonAlertId)\n    | project SystemAlertId, HalcyonAlertId\n) on $left.AlertIds == $right.SystemAlertId\n| join kind=inner LatestStatus on HalcyonAlertId\n| summarize arg_max(TimeGenerated, *) by IncidentName, HalcyonAlertId\n| project IncidentId = IncidentName, HalcyonAlertId, HalcyonTriageStatus, HalcyonDisplayStatus"
                                        },
                                        "retryPolicy": {
                                            "type": "fixed",
                                            "count": 3,
                                            "interval": "PT10S"
                                        }
                                    }
                                },
                                "Check_Result_Size": {
                                    "type": "If",
                                    "runAfter": {
                                        "Run_KQL_Query": ["Succeeded"]
                                    },
                                    "expression": {
                                        "and": [
                                            {
                                                "greater": [
                                                    "@length(body('Run_KQL_Query')?['value'])",
                                                    100
                                                ]
                                            }
                                        ]
                                    },
                                    "actions": {
                                        "Terminate_Too_Many_Rows": {
                                            "type": "Terminate",
                                            "runAfter": {},
                                            "inputs": {
                                                "runStatus": "Failed",
                                                "runError": {
                                                    "code": "TooManyRows",
                                                    "message": "@{concat('KQL returned ', length(body('Run_KQL_Query')?['value']), ' rows — circuit breaker tripped (limit 100). Investigate for duplicate data before re-enabling.')}"
                                                }
                                            }
                                        }
                                    },
                                    "else": {
                                        "actions": {}
                                    }
                                },
                                "For_Each_Alert": {
                                    "type": "Foreach",
                                    "runAfter": {
                                        "Check_Result_Size": ["Succeeded"]
                                    },
                                    "foreach": "@body('Run_KQL_Query')?['value']",
                                    "runtimeConfiguration": {
                                        "concurrency": { "repetitions": 1 }
                                    },
                                    "actions": {
                                        "Compose_Incident_Arm_Id": {
                                            "type": "Compose",
                                            "runAfter": {},
                                            "inputs": "@concat('/subscriptions/', parameters('subscriptionId'), '/resourceGroups/', parameters('resourceGroupName'), '/providers/Microsoft.OperationalInsights/workspaces/', parameters('workspaceName'), '/providers/Microsoft.SecurityInsights/incidents/', items('For_Each_Alert')?['IncidentId'])"
                                        },
                                        "Get_Incident": {
                                            "type": "ApiConnection",
                                            "runAfter": {
                                                "Compose_Incident_Arm_Id": ["Succeeded"]
                                            },
                                            "inputs": {
                                                "host": {
                                                    "connection": {
                                                        "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                                                    }
                                                },
                                                "method": "post",
                                                "path": "/Incidents",
                                                "body": {
                                                    "incidentArmId": "@{outputs('Compose_Incident_Arm_Id')}"
                                                },
                                                "retryPolicy": {
                                                    "type": "fixed",
                                                    "count": 3,
                                                    "interval": "PT10S"
                                                }
                                            }
                                        },
                                        "Filter_Labels_To_Remove": {
                                            "type": "Query",
                                            "runAfter": {
                                                "Get_Incident": ["Succeeded"]
                                            },
                                            "inputs": {
                                                "from": "@coalesce(body('Get_Incident')?['properties']?['labels'], createArray())",
                                                "where": "@or(startsWith(coalesce(item()?['labelName'], ''), 'Halcyon Triage Status:'), startsWith(coalesce(item()?['labelName'], ''), 'Halcyon Display Status:'))"
                                            }
                                        },
                                        "Compose_Triage_Label": {
                                            "type": "Compose",
                                            "runAfter": {
                                                "Filter_Labels_To_Remove": ["Succeeded"]
                                            },
                                            "inputs": "@if(empty(coalesce(items('For_Each_Alert')?['HalcyonTriageStatus'], '')), createArray(), createArray(createObject('Tag', concat('Halcyon Triage Status: ', items('For_Each_Alert')?['HalcyonTriageStatus']))))"
                                        },
                                        "Compose_Display_Label": {
                                            "type": "Compose",
                                            "runAfter": {
                                                "Compose_Triage_Label": ["Succeeded"]
                                            },
                                            "inputs": "@if(empty(coalesce(items('For_Each_Alert')?['HalcyonDisplayStatus'], '')), createArray(), createArray(createObject('Tag', concat('Halcyon Display Status: ', items('For_Each_Alert')?['HalcyonDisplayStatus']))))"
                                        },
                                        "Compose_Tags_To_Add": {
                                            "type": "Compose",
                                            "runAfter": {
                                                "Compose_Display_Label": ["Succeeded"]
                                            },
                                            "inputs": "@union(outputs('Compose_Triage_Label'), outputs('Compose_Display_Label'))"
                                        },
                                        "Compose_Tags_To_Remove": {
                                            "type": "Compose",
                                            "runAfter": {
                                                "Compose_Tags_To_Add": ["Succeeded"]
                                            },
                                            "inputs": "@select(body('Filter_Labels_To_Remove'), createObject('Tag', item()?['labelName']))"
                                        },
                                        "Update_Incident": {
                                            "type": "ApiConnection",
                                            "runAfter": {
                                                "Compose_Tags_To_Remove": ["Succeeded"]
                                            },
                                            "inputs": {
                                                "host": {
                                                    "connection": {
                                                        "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                                                    }
                                                },
                                                "method": "put",
                                                "path": "/Incidents",
                                                "body": {
                                                    "incidentArmId": "@{outputs('Compose_Incident_Arm_Id')}",
                                                    "tagsToAdd": {
                                                        "TagsToAdd": "@outputs('Compose_Tags_To_Add')"
                                                    },
                                                    "tagsToRemove": {
                                                        "TagsToRemove": "@outputs('Compose_Tags_To_Remove')"
                                                    }
                                                },
                                                "retryPolicy": {
                                                    "type": "fixed",
                                                    "count": 3,
                                                    "interval": "PT10S"
                                                }
                                            }
                                        },
                                        "Check_Is_Reviewed": {
                                            "type": "If",
                                            "runAfter": {
                                                "Update_Incident": ["Succeeded"]
                                            },
                                            "expression": {
                                                "and": [
                                                    {
                                                        "equals": [
                                                            "@items('For_Each_Alert')?['HalcyonTriageStatus']",
                                                            "Reviewed"
                                                        ]
                                                    }
                                                ]
                                            },
                                            "actions": {
                                                "Close_Incident": {
                                                    "type": "ApiConnection",
                                                    "runAfter": {},
                                                    "inputs": {
                                                        "host": {
                                                            "connection": {
                                                                "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                                                            }
                                                        },
                                                        "method": "put",
                                                        "path": "/Incidents",
                                                        "body": {
                                                            "incidentArmId": "@{outputs('Compose_Incident_Arm_Id')}",
                                                            "status": "Closed",
                                                            "classification": "Undetermined",
                                                            "classificationComment": "Closed by Halcyon: alert reviewed in Halcyon platform."
                                                        },
                                                        "retryPolicy": {
                                                            "type": "fixed",
                                                            "count": 3,
                                                            "interval": "PT5S"
                                                        }
                                                    }
                                                }
                                            },
                                            "else": {
                                                "actions": {}
                                            }
                                        }
                                    }
                                }
                            }
                        },
                        "Handle_Failure": {
                            "type": "Compose",
                            "runAfter": {
                                "Main_Scope": ["Failed", "Skipped", "TimedOut"]
                            },
                            "inputs": {
                                "message": "Halcyon-IncidentUpdate playbook failed.",
                                "scopeStatus": "@result('Main_Scope')",
                                "runId": "@workflow().run.name",
                                "workflowName": "@workflow().name"
                            }
                        },
                        "Terminate_With_Failure": {
                            "type": "Terminate",
                            "runAfter": {
                                "Handle_Failure": ["Succeeded"]
                            },
                            "inputs": {
                                "runStatus": "Failed",
                                "runError": {
                                    "code": "MainScopeFailed",
                                    "message": "@{string(outputs('Handle_Failure'))}"
                                }
                            }
                        }
                    }
                }
            }
        },
        {
            "type": "Microsoft.Authorization/roleAssignments",
            "apiVersion": "2022-04-01",
            "name": "[guid(resourceId('Microsoft.OperationalInsights/workspaces', parameters('WorkspaceName')), resourceId('Microsoft.Logic/workflows', parameters('PlaybookName')), variables('sentinelResponderRoleId'))]",
            "scope": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('WorkspaceName'))]",
            "dependsOn": [
                "[resourceId('Microsoft.Logic/workflows', parameters('PlaybookName'))]"
            ],
            "properties": {
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('sentinelResponderRoleId'))]",
                "principalId": "[reference(resourceId('Microsoft.Logic/workflows', parameters('PlaybookName')), '2019-05-01', 'Full').identity.principalId]",
                "principalType": "ServicePrincipal"
            }
        },
        {
            "type": "Microsoft.Authorization/roleAssignments",
            "apiVersion": "2022-04-01",
            "name": "[guid(resourceId('Microsoft.OperationalInsights/workspaces', parameters('WorkspaceName')), resourceId('Microsoft.Logic/workflows', parameters('PlaybookName')), variables('logAnalyticsReaderRoleId'))]",
            "scope": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('WorkspaceName'))]",
            "dependsOn": [
                "[resourceId('Microsoft.Logic/workflows', parameters('PlaybookName'))]"
            ],
            "properties": {
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('logAnalyticsReaderRoleId'))]",
                "principalId": "[reference(resourceId('Microsoft.Logic/workflows', parameters('PlaybookName')), '2019-05-01', 'Full').identity.principalId]",
                "principalType": "ServicePrincipal"
            }
        },
        {
            "type": "Microsoft.Authorization/roleAssignments",
            "apiVersion": "2022-04-01",
            "name": "[guid(resourceId('Microsoft.OperationalInsights/workspaces', parameters('WorkspaceName')), resourceId('Microsoft.Logic/workflows', parameters('PlaybookName')), variables('monitoringReaderRoleId'))]",
            "scope": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('WorkspaceName'))]",
            "dependsOn": [
                "[resourceId('Microsoft.Logic/workflows', parameters('PlaybookName'))]"
            ],
            "properties": {
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('monitoringReaderRoleId'))]",
                "principalId": "[reference(resourceId('Microsoft.Logic/workflows', parameters('PlaybookName')), '2019-05-01', 'Full').identity.principalId]",
                "principalType": "ServicePrincipal"
            }
        }
    ]
}
