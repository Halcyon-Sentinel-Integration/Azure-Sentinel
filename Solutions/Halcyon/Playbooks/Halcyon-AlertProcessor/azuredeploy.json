{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "metadata": {
        "title": "Halcyon-AlertProcessor",
        "description": "Polls SecurityAlert every minute, deduplicates against a Sentinel watchlist on HalcyonAlertId, creates Sentinel incidents via the ARM API, and best-effort links the discovering SecurityAlert.",
        "prerequisites": [
            "1. The Halcyon data connector must be deployed and ingesting data into Halcyon_Commands_CL.",
            "2. The Halcyon analytics rule (Halcyon - New Alert Detected) must be deployed and emitting SecurityAlerts with entity mappings. The rule must have createIncident: false.",
            "3. The deploying principal must have permission to create role assignments on the Log Analytics workspace."
        ],
        "tags": ["Halcyon", "AlertProcessor"],
        "author": { "name": "Halcyon" },
        "support": { "tier": "developer", "link": "https://www.halcyon.ai" }
    },
    "parameters": {
        "PlaybookName": {
            "type": "string",
            "defaultValue": "Halcyon-AlertProcessor"
        },
        "WorkspaceName": {
            "type": "string",
            "metadata": { "description": "Name of the Log Analytics workspace containing Halcyon_Commands_CL and Microsoft Sentinel." }
        },
        "SubscriptionId": {
            "type": "string",
            "defaultValue": "[subscription().subscriptionId]"
        },
        "ResourceGroupName": {
            "type": "string",
            "defaultValue": "[resourceGroup().name]"
        },
        "WatchlistAlias": {
            "type": "string",
            "defaultValue": "HalcyonProcessedIds",
            "metadata": { "description": "Alias of the Sentinel watchlist used to track already-processed HalcyonAlertIds." }
        },
        "RecurrenceFrequency": {
            "type": "string",
            "defaultValue": "Minute",
            "allowedValues": ["Minute", "Hour"]
        },
        "RecurrenceInterval": {
            "type": "int",
            "defaultValue": 1,
            "metadata": { "description": "How often to run the processor, in units of RecurrenceFrequency." }
        }
    },
    "variables": {
        "sentinelContributorRoleId": "ab8e14d6-4a74-4a29-9ba8-549422addade",
        "logAnalyticsReaderRoleId": "73c42c96-874c-492b-b04d-ab87d138a893",
        "monitoringReaderRoleId": "43d0d8ad-25c7-4714-9337-8ba259a9fe05",
        "azureMonitorLogsConnectionName": "[concat('azuremonitorlogs-', parameters('PlaybookName'))]",
        "azureSentinelConnectionName": "[concat('azuresentinel-', parameters('PlaybookName'))]"
    },
    "resources": [
        {
            "type": "Microsoft.Web/connections",
            "apiVersion": "2016-06-01",
            "name": "[variables('azureMonitorLogsConnectionName')]",
            "location": "[resourceGroup().location]",
            "kind": "V1",
            "properties": {
                "displayName": "[variables('azureMonitorLogsConnectionName')]",
                "customParameterValues": {},
                "parameterValueSet": {
                    "name": "managedIdentityAuth",
                    "values": {}
                },
                "api": {
                    "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/azuremonitorlogs')]"
                }
            }
        },
        {
            "type": "Microsoft.Web/connections",
            "apiVersion": "2016-06-01",
            "name": "[variables('azureSentinelConnectionName')]",
            "location": "[resourceGroup().location]",
            "kind": "V1",
            "properties": {
                "displayName": "[variables('azureSentinelConnectionName')]",
                "customParameterValues": {},
                "parameterValueType": "Alternative",
                "api": {
                    "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/azuresentinel')]"
                }
            }
        },
        {
            "type": "Microsoft.OperationalInsights/workspaces/providers/watchlists",
            "apiVersion": "2023-12-01-preview",
            "name": "[concat(parameters('WorkspaceName'), '/Microsoft.SecurityInsights/', parameters('WatchlistAlias'))]",
            "properties": {
                "displayName": "Halcyon Processed Alert IDs",
                "description": "Tracks HalcyonAlertIds that have been processed by the Halcyon-AlertProcessor playbook to prevent duplicate incidents.",
                "provider": "Halcyon Solution",
                "source": "Local file",
                "itemsSearchKey": "HalcyonAlertId",
                "contentType": "Text/Csv",
                "numberOfLinesToSkip": 0,
                "rawContent": "HalcyonAlertId,ProcessedTime\n"
            }
        },
        {
            "type": "Microsoft.Logic/workflows",
            "apiVersion": "2019-05-01",
            "name": "[parameters('PlaybookName')]",
            "location": "[resourceGroup().location]",
            "identity": {
                "type": "SystemAssigned"
            },
            "dependsOn": [
                "[resourceId('Microsoft.Web/connections', variables('azureMonitorLogsConnectionName'))]",
                "[resourceId('Microsoft.Web/connections', variables('azureSentinelConnectionName'))]",
                "[resourceId('Microsoft.OperationalInsights/workspaces/providers/watchlists', parameters('WorkspaceName'), 'Microsoft.SecurityInsights', parameters('WatchlistAlias'))]"
            ],
            "properties": {
                "state": "Enabled",
                "parameters": {
                    "$connections": {
                        "value": {
                            "azuremonitorlogs": {
                                "connectionId": "[resourceId('Microsoft.Web/connections', variables('azureMonitorLogsConnectionName'))]",
                                "connectionName": "[variables('azureMonitorLogsConnectionName')]",
                                "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/azuremonitorlogs')]",
                                "connectionProperties": {
                                    "authentication": {
                                        "type": "ManagedServiceIdentity"
                                    }
                                }
                            },
                            "azuresentinel": {
                                "connectionId": "[resourceId('Microsoft.Web/connections', variables('azureSentinelConnectionName'))]",
                                "connectionName": "[variables('azureSentinelConnectionName')]",
                                "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/azuresentinel')]",
                                "connectionProperties": {
                                    "authentication": {
                                        "type": "ManagedServiceIdentity"
                                    }
                                }
                            }
                        }
                    }
                },
                "definition": {
                    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
                    "contentVersion": "1.0.0.0",
                    "parameters": {
                        "$connections": {
                            "defaultValue": {},
                            "type": "Object"
                        },
                        "subscriptionId": {
                            "type": "string",
                            "defaultValue": "[parameters('SubscriptionId')]"
                        },
                        "resourceGroupName": {
                            "type": "string",
                            "defaultValue": "[parameters('ResourceGroupName')]"
                        },
                        "workspaceName": {
                            "type": "string",
                            "defaultValue": "[parameters('WorkspaceName')]"
                        },
                        "workspaceId": {
                            "type": "string",
                            "defaultValue": "[reference(resourceId('Microsoft.OperationalInsights/workspaces', parameters('WorkspaceName')), '2022-10-01').customerId]"
                        },
                        "watchlistAlias": {
                            "type": "string",
                            "defaultValue": "[parameters('WatchlistAlias')]"
                        },
                        "armEndpoint": {
                            "type": "string",
                            "defaultValue": "[environment().resourceManager]"
                        }
                    },
                    "triggers": {
                        "Recurrence": {
                            "type": "Recurrence",
                            "recurrence": {
                                "frequency": "[parameters('RecurrenceFrequency')]",
                                "interval": "[parameters('RecurrenceInterval')]"
                            },
                            "runtimeConfiguration": {
                                "concurrency": {
                                    "runs": 1
                                }
                            }
                        }
                    },
                    "actions": {
                        "Main_Scope": {
                            "type": "Scope",
                            "runAfter": {},
                            "actions": {
                                "Run_KQL_Query": {
                                    "type": "ApiConnection",
                                    "runAfter": {},
                                    "inputs": {
                                        "host": {
                                            "connection": {
                                                "name": "@parameters('$connections')['azuremonitorlogs']['connectionId']"
                                            }
                                        },
                                        "method": "post",
                                        "path": "/queryData",
                                        "queries": {
                                            "subscriptions": "@parameters('subscriptionId')",
                                            "resourcegroups": "@parameters('resourceGroupName')",
                                            "resourcetype": "Log Analytics Workspace",
                                            "resourcename": "@parameters('workspaceName')",
                                            "timerange": "Set in query"
                                        },
                                        "body": {
                                            "query": "SecurityAlert\n| where TimeGenerated > ago(10m)\n| where AlertName has \"Halcyon\"\n| extend CustomDetails = parse_json(tostring(parse_json(tostring(ExtendedProperties))[\"Custom Details\"]))\n| extend HalcyonAlertId = tostring(CustomDetails[\"HalcyonAlertId\"][0])\n| where isnotempty(HalcyonAlertId)\n| summarize arg_max(TimeGenerated, *) by HalcyonAlertId\n| project HalcyonAlertId, SystemAlertId, AlertName, TimeGenerated, Description, AlertSeverity"
                                        },
                                        "retryPolicy": {
                                            "type": "fixed",
                                            "count": 3,
                                            "interval": "PT10S"
                                        }
                                    }
                                },
                                "Foreach_Result": {
                                    "type": "Foreach",
                                    "runAfter": {
                                        "Run_KQL_Query": ["Succeeded"]
                                    },
                                    "foreach": "@body('Run_KQL_Query')?['value']",
                                    "runtimeConfiguration": {
                                        "concurrency": { "repetitions": 1 }
                                    },
                                    "actions": {
                                        "Compose_Alert_Guid": {
                                            "type": "Compose",
                                            "runAfter": {},
                                            "inputs": "@{concat(substring(items('Foreach_Result')?['HalcyonAlertId'], 0, 8), '-', substring(items('Foreach_Result')?['HalcyonAlertId'], 8, 4), '-', '5', substring(items('Foreach_Result')?['HalcyonAlertId'], 13, 3), '-', 'a', substring(items('Foreach_Result')?['HalcyonAlertId'], 17, 3), '-', substring(items('Foreach_Result')?['HalcyonAlertId'], 20, 12))}"
                                        },
                                        "Compose_Labels": {
                                            "type": "Compose",
                                            "runAfter": {
                                                "Compose_Alert_Guid": ["Succeeded"]
                                            },
                                            "inputs": [{ "labelName": "Halcyon" }]
                                        },
                                        "Read_Watchlist_Item": {
                                            "type": "ApiConnection",
                                            "runAfter": {
                                                "Compose_Alert_Guid": ["Succeeded"]
                                            },
                                            "inputs": {
                                                "host": {
                                                    "connection": {
                                                        "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                                                    }
                                                },
                                                "method": "get",
                                                "path": "/Watchlists/subscriptions/@{encodeURIComponent(parameters('subscriptionId'))}/resourceGroups/@{encodeURIComponent(parameters('resourceGroupName'))}/workspaces/@{encodeURIComponent(parameters('workspaceId'))}/watchlists/@{encodeURIComponent(parameters('watchlistAlias'))}/watchlistItem/@{encodeURIComponent(outputs('Compose_Alert_Guid'))}"
                                            }
                                        },
                                        "Check_If_Already_Processed": {
                                            "type": "If",
                                            "runAfter": {
                                                "Read_Watchlist_Item": ["Succeeded", "Failed"],
                                                "Compose_Labels": ["Succeeded"]
                                            },
                                            "expression": {
                                                "or": [
                                                    {
                                                        "equals": [
                                                            "@coalesce(outputs('Read_Watchlist_Item')?['statusCode'], 404)",
                                                            404
                                                        ]
                                                    },
                                                    {
                                                        "equals": [
                                                            "@actions('Read_Watchlist_Item')?['status']",
                                                            "Failed"
                                                        ]
                                                    }
                                                ]
                                            },
                                            "actions": {
                                                "Add_To_Watchlist": {
                                                    "type": "ApiConnection",
                                                    "runAfter": {},
                                                    "inputs": {
                                                        "host": {
                                                            "connection": {
                                                                "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                                                            }
                                                        },
                                                        "method": "put",
                                                        "path": "/Watchlists/subscriptions/@{encodeURIComponent(parameters('subscriptionId'))}/resourceGroups/@{encodeURIComponent(parameters('resourceGroupName'))}/workspaces/@{encodeURIComponent(parameters('workspaceId'))}/watchlists/@{encodeURIComponent(parameters('watchlistAlias'))}/watchlistItem/@{encodeURIComponent(outputs('Compose_Alert_Guid'))}",
                                                        "body": {
                                                            "HalcyonAlertId": "@{items('Foreach_Result')?['HalcyonAlertId']}",
                                                            "ProcessedTime": "@{utcNow()}"
                                                        },
                                                        "retryPolicy": {
                                                            "type": "fixed",
                                                            "count": 3,
                                                            "interval": "PT10S"
                                                        }
                                                    }
                                                },
                                                "Create_Incident": {
                                                    "type": "Http",
                                                    "runAfter": {
                                                        "Add_To_Watchlist": ["Succeeded"]
                                                    },
                                                    "inputs": {
                                                        "method": "PUT",
                                                        "uri": "@{concat(parameters('armEndpoint'), 'subscriptions/', parameters('subscriptionId'), '/resourceGroups/', parameters('resourceGroupName'), '/providers/Microsoft.OperationalInsights/workspaces/', parameters('workspaceName'), '/providers/Microsoft.SecurityInsights/incidents/', outputs('Compose_Alert_Guid'), '?api-version=2024-03-01')}",
                                                        "headers": {
                                                            "Content-Type": "application/json"
                                                        },
                                                        "body": {
                                                            "properties": {
                                                                "title": "@{concat('Halcyon Alert: ', items('Foreach_Result')?['HalcyonAlertId'])}",
                                                                "description": "@{items('Foreach_Result')?['Description']}",
                                                                "severity": "High",
                                                                "status": "New",
                                                                "labels": "@outputs('Compose_Labels')"
                                                            }
                                                        },
                                                        "authentication": {
                                                            "type": "ManagedServiceIdentity",
                                                            "audience": "@{parameters('armEndpoint')}"
                                                        },
                                                        "retryPolicy": {
                                                            "type": "fixed",
                                                            "count": 3,
                                                            "interval": "PT10S"
                                                        }
                                                    }
                                                },
                                                "Link_Alert_Scope": {
                                                    "type": "Scope",
                                                    "runAfter": {
                                                        "Create_Incident": ["Succeeded"]
                                                    },
                                                    "actions": {
                                                        "Link_Alert_To_Incident": {
                                                            "type": "ApiConnection",
                                                            "runAfter": {},
                                                            "inputs": {
                                                                "host": {
                                                                    "connection": {
                                                                        "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                                                                    }
                                                                },
                                                                "method": "post",
                                                                "path": "/Incidents/Relation/Create",
                                                                "body": {
                                                                    "incidentArmId": "@{concat('/subscriptions/', parameters('subscriptionId'), '/resourceGroups/', parameters('resourceGroupName'), '/providers/Microsoft.OperationalInsights/workspaces/', parameters('workspaceName'), '/providers/Microsoft.SecurityInsights/incidents/', outputs('Compose_Alert_Guid'))}",
                                                                    "relatedResourceId": "@{concat('/subscriptions/', parameters('subscriptionId'), '/resourceGroups/', parameters('resourceGroupName'), '/providers/Microsoft.OperationalInsights/workspaces/', parameters('workspaceName'), '/providers/Microsoft.SecurityInsights/entities/', items('Foreach_Result')?['SystemAlertId'])}"
                                                                },
                                                                "retryPolicy": {
                                                                    "type": "fixed",
                                                                    "count": 3,
                                                                    "interval": "PT10S"
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            },
                                            "else": {
                                                "actions": {}
                                            }
                                        }
                                    }
                                }
                            }
                        },
                        "Handle_Failure": {
                            "type": "Compose",
                            "runAfter": {
                                "Main_Scope": ["Failed", "Skipped", "TimedOut"]
                            },
                            "inputs": {
                                "message": "Halcyon-AlertProcessor playbook failed.",
                                "scopeStatus": "@result('Main_Scope')",
                                "runId": "@workflow().run.name",
                                "workflowName": "@workflow().name"
                            }
                        },
                        "Terminate_With_Failure": {
                            "type": "Terminate",
                            "runAfter": {
                                "Handle_Failure": ["Succeeded"]
                            },
                            "inputs": {
                                "runStatus": "Failed",
                                "runError": {
                                    "code": "MainScopeFailed",
                                    "message": "@{string(outputs('Handle_Failure'))}"
                                }
                            }
                        }
                    }
                }
            }
        },
        {
            "type": "Microsoft.Authorization/roleAssignments",
            "apiVersion": "2022-04-01",
            "name": "[guid(resourceId('Microsoft.OperationalInsights/workspaces', parameters('WorkspaceName')), resourceId('Microsoft.Logic/workflows', parameters('PlaybookName')), variables('sentinelContributorRoleId'))]",
            "scope": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('WorkspaceName'))]",
            "dependsOn": [
                "[resourceId('Microsoft.Logic/workflows', parameters('PlaybookName'))]"
            ],
            "properties": {
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('sentinelContributorRoleId'))]",
                "principalId": "[reference(resourceId('Microsoft.Logic/workflows', parameters('PlaybookName')), '2019-05-01', 'Full').identity.principalId]",
                "principalType": "ServicePrincipal"
            }
        },
        {
            "type": "Microsoft.Authorization/roleAssignments",
            "apiVersion": "2022-04-01",
            "name": "[guid(resourceId('Microsoft.OperationalInsights/workspaces', parameters('WorkspaceName')), resourceId('Microsoft.Logic/workflows', parameters('PlaybookName')), variables('logAnalyticsReaderRoleId'))]",
            "scope": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('WorkspaceName'))]",
            "dependsOn": [
                "[resourceId('Microsoft.Logic/workflows', parameters('PlaybookName'))]"
            ],
            "properties": {
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('logAnalyticsReaderRoleId'))]",
                "principalId": "[reference(resourceId('Microsoft.Logic/workflows', parameters('PlaybookName')), '2019-05-01', 'Full').identity.principalId]",
                "principalType": "ServicePrincipal"
            }
        },
        {
            "type": "Microsoft.Authorization/roleAssignments",
            "apiVersion": "2022-04-01",
            "name": "[guid(resourceId('Microsoft.OperationalInsights/workspaces', parameters('WorkspaceName')), resourceId('Microsoft.Logic/workflows', parameters('PlaybookName')), variables('monitoringReaderRoleId'))]",
            "scope": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('WorkspaceName'))]",
            "dependsOn": [
                "[resourceId('Microsoft.Logic/workflows', parameters('PlaybookName'))]"
            ],
            "properties": {
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('monitoringReaderRoleId'))]",
                "principalId": "[reference(resourceId('Microsoft.Logic/workflows', parameters('PlaybookName')), '2019-05-01', 'Full').identity.principalId]",
                "principalType": "ServicePrincipal"
            }
        }
    ]
}
